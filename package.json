{
  "name": "ehpad-crecy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/optimize-site-assets.js && node scripts/optimize-gallery.js && next dev --webpack",
    "build": "node scripts/optimize-site-assets.js && node scripts/optimize-gallery.js && next build --webpack && node scripts/prune-unused-image-originals.js && node scripts/deduplicate-static-media.js",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "monitor:production": "node scripts/monitor-production.mjs",
    "sync:fhf-jobs": "tsx scripts/sync-fhf-jobs.ts",
    "performance:budget": "node scripts/check-performance-budget.js",
    "check": "npm run lint && npm run typecheck && npm test",
    "deploy:direct": "npm run build && npx netlify-cli deploy --prod --dir=out"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.13",
    "@netlify/functions": "^5.1.2",
    "@studio-freight/lenis": "^1.0.42",
    "@types/pannellum": "^2.5.0",
    "archiver": "^7.0.1",
    "framer-motion": "^12.26.1",
    "gray-matter": "^4.0.3",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "netlify-identity-widget": "^1.9.2",
    "next": "16.3.1",
    "nodemailer": "^9.0.5",
    "pannellum": "^2.5.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "netlify-cli": "^27.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
